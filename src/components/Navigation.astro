---
import { getLocaleFromUrl, getNavItems, getLocalizedPath, getBasePath, locales, localeNames, defaultLocale, type Locale } from '../i18n/index';
import { getTranslations } from '../i18n/index';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = getTranslations(currentLocale);
const navItems = getNavItems(currentLocale);
const basePath = getBasePath(Astro.url.pathname);
const prefix = currentLocale === defaultLocale ? '' : `/${currentLocale}`;
const kontaktHref = `${prefix}/kontakt`;
---

<nav class="fixed w-full z-50 transition-all duration-300 bg-stone-900/80 backdrop-blur-md" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href={prefix || '/'} class="flex items-center">
        <img src="/images/logo.png" alt="Hera Sauna" class="h-14 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-white/90 hover:text-white hover:bg-white/10 px-4 py-2 rounded-lg transition-all duration-200 font-medium text-sm uppercase tracking-wide"
          >
            {item.name}
          </a>
        ))}

        <!-- Language Switcher -->
        <div class="flex items-center ml-3 border-l border-white/20 pl-3 gap-1">
          {locales.map((loc) => {
            const href = getLocalizedPath(basePath, loc);
            const isActive = loc === currentLocale;
            return (
              <a
                href={href}
                class={`px-2 py-1 rounded text-xs font-bold transition-all duration-200 ${
                  isActive
                    ? 'bg-bronze-500 text-white'
                    : 'text-white/60 hover:text-white hover:bg-white/10'
                }`}
                aria-label={`Switch to ${loc}`}
              >
                {localeNames[loc]}
              </a>
            );
          })}
        </div>

        <a
          href={kontaktHref}
          class="ml-4 bg-bronze-500 hover:bg-bronze-600 text-white px-5 py-2 rounded-lg transition-colors duration-200 font-semibold text-sm uppercase tracking-wide"
        >
          {t.nav.visitUs}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-stone-900/95 backdrop-blur-md">
    <div class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block text-white/90 hover:text-white hover:bg-white/10 px-4 py-3 rounded-lg transition-all"
        >
          {item.name}
        </a>
      ))}
      <a
        href={kontaktHref}
        class="block bg-bronze-500 text-white text-center px-4 py-3 rounded-lg mt-4 font-semibold"
      >
        {t.nav.visitUs}
      </a>

      <!-- Mobile Language Switcher -->
      <div class="flex items-center justify-center gap-2 pt-4 border-t border-white/10 mt-4">
        {locales.map((loc) => {
          const href = getLocalizedPath(basePath, loc);
          const isActive = loc === currentLocale;
          return (
            <a
              href={href}
              class={`px-3 py-2 rounded text-sm font-bold transition-all duration-200 ${
                isActive
                  ? 'bg-bronze-500 text-white'
                  : 'text-white/60 hover:text-white hover:bg-white/10'
              }`}
            >
              {localeNames[loc]}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const nav = document.getElementById('main-nav');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Darken background on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.remove('bg-stone-900/80');
      nav?.classList.add('bg-stone-900/95', 'shadow-lg');
    } else {
      nav?.classList.remove('bg-stone-900/95', 'shadow-lg');
      nav?.classList.add('bg-stone-900/80');
    }
  });
</script>
