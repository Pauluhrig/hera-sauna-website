---
import { getLocaleFromUrl, getNavItems, getLocalizedPath, getBasePath, locales, localeNames, defaultLocale, type Locale } from '../i18n/index';
import { getTranslations } from '../i18n/index';

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = getTranslations(currentLocale);
const navItems = getNavItems(currentLocale);
const basePath = getBasePath(Astro.url.pathname);
const prefix = currentLocale === defaultLocale ? '' : `/${currentLocale}`;
const kontaktHref = `${prefix}/kontakt`;
---

<nav class="fixed w-full z-50 transition-all duration-300 bg-stone-900/80 backdrop-blur-md" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href={prefix || '/'} class="flex items-center">
        <img src="/images/logo.png" alt="Hera Sauna" class="h-14 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-white/90 hover:text-white hover:bg-white/10 px-4 py-2 rounded-lg transition-all duration-200 font-medium text-sm uppercase tracking-wide"
          >
            {item.name}
          </a>
        ))}

        <!-- Language Switcher (Globe Dropdown) -->
        <div class="relative ml-3 border-l border-white/20 pl-3" id="lang-switcher">
          <button
            id="lang-toggle"
            class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-all duration-200"
            aria-label="Switch language"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span class="text-xs font-bold uppercase">{localeNames[currentLocale]}</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="lang-dropdown" class="hidden absolute right-0 top-full mt-2 bg-stone-800 rounded-lg shadow-xl border border-white/10 overflow-hidden min-w-[120px]">
            {locales.map((loc) => {
              const href = getLocalizedPath(basePath, loc);
              const isActive = loc === currentLocale;
              return (
                <a
                  href={href}
                  class={`block px-4 py-2.5 text-sm font-medium transition-all ${
                    isActive
                      ? 'bg-bronze-500 text-white'
                      : 'text-white/70 hover:text-white hover:bg-white/10'
                  }`}
                >
                  {loc === 'en' ? '🇬🇧 English' : loc === 'de' ? '🇩🇪 Deutsch' : loc === 'th' ? '🇹🇭 ภาษาไทย' : '🇷🇺 Русский'}
                </a>
              );
            })}
          </div>
        </div>

        <a
          href={kontaktHref}
          class="ml-4 bg-bronze-500 hover:bg-bronze-600 text-white px-5 py-2 rounded-lg transition-colors duration-200 font-semibold text-sm uppercase tracking-wide"
        >
          {t.nav.visitUs}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-stone-900/95 backdrop-blur-md">
    <div class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block text-white/90 hover:text-white hover:bg-white/10 px-4 py-3 rounded-lg transition-all"
        >
          {item.name}
        </a>
      ))}
      <a
        href={kontaktHref}
        class="block bg-bronze-500 text-white text-center px-4 py-3 rounded-lg mt-4 font-semibold"
      >
        {t.nav.visitUs}
      </a>

      <!-- Mobile Language Switcher (Globe + list) -->
      <div class="pt-4 border-t border-white/10 mt-4">
        <div class="flex items-center gap-2 px-4 mb-3 text-white/50 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          Language
        </div>
        <div class="grid grid-cols-2 gap-2 px-4">
          {locales.map((loc) => {
            const href = getLocalizedPath(basePath, loc);
            const isActive = loc === currentLocale;
            return (
              <a
                href={href}
                class={`px-3 py-2.5 rounded-lg text-sm font-medium text-center transition-all ${
                  isActive
                    ? 'bg-bronze-500 text-white'
                    : 'text-white/60 hover:text-white bg-white/5 hover:bg-white/10'
                }`}
              >
                {loc === 'en' ? '🇬🇧 EN' : loc === 'de' ? '🇩🇪 DE' : loc === 'th' ? '🇹🇭 TH' : '🇷🇺 RU'}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const nav = document.getElementById('main-nav');
  const langToggle = document.getElementById('lang-toggle');
  const langDropdown = document.getElementById('lang-dropdown');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Language dropdown toggle
  langToggle?.addEventListener('click', () => {
    langDropdown?.classList.toggle('hidden');
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const switcher = document.getElementById('lang-switcher');
    if (switcher && !switcher.contains(e.target as Node)) {
      langDropdown?.classList.add('hidden');
    }
  });

  // Darken background on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.remove('bg-stone-900/80');
      nav?.classList.add('bg-stone-900/95', 'shadow-lg');
    } else {
      nav?.classList.remove('bg-stone-900/95', 'shadow-lg');
      nav?.classList.add('bg-stone-900/80');
    }
  });
</script>
