---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations, getLocaleFromUrl, defaultLocale } from '../../i18n/index';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const prefix = locale === defaultLocale ? '' : `/${locale}`;
---

<Layout title={t.prices.title} description={t.prices.description} locale={locale}>
  <Navigation locale={locale} />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-stone-800 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-serif font-bold mb-6">
        <span class="text-bronze-400">{t.prices.heroTitle}</span>
      </h1>
      <p class="text-xl text-stone-300">
        {t.prices.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Main Entry -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden mb-8">
        <div class="bg-bronze-500 p-8 text-center">
          <h2 class="text-2xl font-bold text-stone-900">{t.prices.dayPass}</h2>
          <p class="text-5xl font-bold text-stone-900 mt-4">220 &#xe3f;</p>
          <p class="text-stone-800 mt-2">{t.prices.perPerson}</p>
        </div>
        <div class="p-8">
          <h3 class="text-lg font-semibold text-stone-800 mb-4">{t.prices.includes}</h3>
          <ul class="space-y-3">
            {[t.prices.fullDayAccess, t.prices.finnishSauna, t.prices.steamRoom, t.prices.hotOnsen, t.prices.coldOnsen, t.prices.iceBath, t.prices.swimmingPool, t.prices.gardenArea].map((item) => (
              <li class="flex items-center text-stone-700">
                <svg class="w-5 h-5 text-bronze-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
            <li class="flex items-center text-stone-700">
              <svg class="w-5 h-5 text-bronze-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="font-semibold text-bronze-600">{t.prices.allSessions}</span>
            </li>
          </ul>
          <div class="mt-8 text-center">
            <a
              href={`${prefix}/kontakt`}
              class="inline-block bg-bronze-500 hover:bg-bronze-600 text-white font-semibold px-8 py-4 rounded-lg transition-colors duration-200"
            >
              {t.prices.visitUsToday}
            </a>
          </div>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-md">
          <h3 class="text-lg font-semibold text-stone-800 mb-3">{t.prices.restaurantTitle}</h3>
          <p class="text-stone-600">{t.prices.restaurantDesc}</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-md">
          <h3 class="text-lg font-semibold text-stone-800 mb-3">{t.prices.groupsTitle}</h3>
          <p class="text-stone-600">{t.prices.groupsDesc}</p>
        </div>
      </div>

      <!-- Payment Info -->
      <div class="mt-8 bg-stone-100 rounded-xl p-6 text-center">
        <p class="text-stone-600">{t.prices.paymentInfo}</p>
      </div>
    </div>
  </section>

  <Footer locale={locale} />
</Layout>
