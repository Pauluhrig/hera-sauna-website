---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations, getLocaleFromUrl, defaultLocale } from '../../i18n/index';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const prefix = locale === defaultLocale ? '' : `/${locale}`;

const sessionTimes = [
  { time: '13:00', name: t.sessions.sessionTimes.midday, description: t.sessions.sessionTimes.middayDesc },
  { time: '14:00', name: t.sessions.sessionTimes.afternoon, description: t.sessions.sessionTimes.afternoonDesc },
  { time: '16:00', name: t.sessions.sessionTimes.lateAfternoon, description: t.sessions.sessionTimes.lateAfternoonDesc },
  { time: '19:30', name: t.sessions.sessionTimes.evening, description: t.sessions.sessionTimes.eveningDesc },
];
---

<Layout title={t.sessions.title} description={t.sessions.description} locale={locale}>
  <Navigation locale={locale} />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-stone-800 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-serif font-bold mb-6">
        <span class="text-bronze-400">{t.sessions.heroTitle}</span>{t.sessions.heroTitleSuffix}
      </h1>
      <p class="text-xl text-stone-300">
        {t.sessions.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- What is a Sauna Session -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-serif font-bold text-stone-800 mb-6">
            {t.sessions.whatIsTitle}
          </h2>
          <p class="text-stone-600 text-lg mb-4" set:html={t.sessions.whatIsDesc1} />
          <p class="text-stone-600 text-lg mb-4" set:html={t.sessions.whatIsDesc2} />
          <p class="text-stone-600 text-lg mb-4">
            {t.sessions.whatIsDesc3}
          </p>
          <div class="bg-bronze-100 border-l-4 border-bronze-500 p-4 rounded-r-lg mt-6">
            <p class="text-bronze-800 font-medium">
              {t.sessions.uniqueNote}
            </p>
          </div>
        </div>
        <div>
          <img
            src="/images/03-aufguss-frau-kelle.jpg"
            alt="Sauna Session Ceremony"
            class="rounded-xl shadow-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Daily Schedule -->
  <section class="py-20 bg-bronze-500">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-4xl font-serif font-bold text-white text-center mb-12">
        {t.sessions.scheduleTitle}
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {sessionTimes.map((session) => (
          <div class="bg-white rounded-xl p-6 text-center shadow-lg hover:scale-105 transition-transform">
            <p class="text-3xl font-bold text-bronze-600">{session.time}</p>
            <p class="text-stone-800 font-semibold mt-2">{session.name}</p>
            <p class="text-stone-600 text-sm mt-1">{session.description}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-white mt-8 text-lg">
        {t.sessions.sessionsIncluded}
      </p>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-stone-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-serif font-bold text-stone-800 text-center mb-12">
        {t.sessions.benefitsTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitRelaxation}</h3>
          <p class="text-stone-600">{t.sessions.benefitRelaxationDesc}</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitCirculation}</h3>
          <p class="text-stone-600">{t.sessions.benefitCirculationDesc}</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitSkin}</h3>
          <p class="text-stone-600">{t.sessions.benefitSkinDesc}</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitAroma}</h3>
          <p class="text-stone-600">{t.sessions.benefitAromaDesc}</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitMuscle}</h3>
          <p class="text-stone-600">{t.sessions.benefitMuscleDesc}</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-bronze-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-bronze-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-800 mb-3">{t.sessions.benefitSocial}</h3>
          <p class="text-stone-600">{t.sessions.benefitSocialDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-stone-800 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-serif font-bold mb-4">
        {t.sessions.ctaTitle}
      </h2>
      <p class="text-lg text-stone-300 mb-6">
        {t.sessions.ctaDesc}
      </p>
      <a href={`${prefix}/kontakt`} class="inline-block bg-bronze-500 hover:bg-bronze-600 text-white font-semibold px-8 py-4 rounded-lg transition-colors duration-200">
        {t.sessions.getDirections}
      </a>
    </div>
  </section>

  <Footer locale={locale} />
</Layout>
